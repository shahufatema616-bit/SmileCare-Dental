# Optional Mailtrap setup for real-looking confirmation emails
# Create a free inbox at https://mailtrap.io then fill these in:

MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
MAILTRAP_PORT=2525
DEFAULT_FROM_EMAIL=noreply@smilecare.local

# Or keep console email (default) — messages print in the terminal running runserver.
